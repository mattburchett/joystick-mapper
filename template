# Template file for 'joystick-mapper' (Void Linux xbps-src).
# To build: copy to srcpkgs/joystick-mapper/template in a void-packages
# checkout, then run: ./xbps-src pkg joystick-mapper
pkgname=joystick-mapper
version=0.1.0
revision=1
build_style=go
