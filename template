go_mod_mode=vendor
go_ldflags="-s -w"
hostmakedepends="pkg-config"
makedepends="libglvnd-devel libX11-devel libXcursor-devel libXi-devel
 libXinerama-devel libXrandr-devel libXxf86vm-devel"
short_desc="Map joystick buttons and axes to programmable keyboard sequences"
maintainer="Matt Burchett <mattburchett@users.noreply.github.com>"
